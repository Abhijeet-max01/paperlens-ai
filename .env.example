# ==============================================================================
# PaperLens-AI Environment Configuration
# ==============================================================================

# Project Metadata
PROJECT_NAME="PaperLens-AI"
VERSION="1.0.0"
API_PREFIX="/api"

# Execution Hardware
# Options: "cpu", "cuda", or "auto" (auto-detects NVIDIA GPU availability)
FORCE_DEVICE="cpu"

# Storage Directories (Relative or Absolute paths)
DATA_DIR="backend/data"
FAISS_DIR="backend/data/faiss_index"
UPLOAD_DIR="backend/data/uploads"

# Database Configuration (SQLite WAL mode enabled by default)
DATABASE_URL="sqlite:///./backend/data/paperlens.db"

# NLP & Embedding Models
# Local Hugging Face / Sentence-Transformers model identifiers
EMBEDDING_MODEL_NAME="BAAI/bge-small-en-v1.5"
NLI_MODEL_NAME="cross-encoder/nli-deberta-v3-small"
SPACY_MODEL="en_core_web_sm"

# Offline Mode (Prevents online model checks during inference)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Tesseract OCR Executable Path (Windows UB-Mannheim default)
# If installed, set to the full path of tesseract.exe. If not found, graceful fallback is used.
TESSERACT_PATH="C:\\Program Files\\Tesseract-OCR\\tesseract.exe"

# Text Processing & Chunking Parameters
CHUNK_SIZE=300
CHUNK_OVERLAP=50
MIN_CLAIM_CONFIDENCE=0.55
NLI_SIMILARITY_THRESHOLD=0.60
